<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado: presionado o seleccionado (checked) -->
    <item android:drawable="@color/filter_active_background" android:state_pressed="true"/>
    <item android:drawable="@color/filter_active_background" android:state_checked="true"/>

    <!-- Estado: por defecto (transparente) -->
    <item android:drawable="@android:color/transparent" />
</selector>